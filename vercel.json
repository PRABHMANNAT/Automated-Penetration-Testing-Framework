{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python demo_snapshot.py && npm ci --include=dev --no-audit --no-fund && npm run build",
  "functions": {
    "server.py": {
      "includeFiles": "{dist/**/*,demo-signing.key}",
      "excludeFiles": "{node_modules/**,src/**,.data/**}"
    }
  }
}
