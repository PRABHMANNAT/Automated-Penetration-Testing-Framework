{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm ci --include=dev --no-audit --no-fund && npm run build",
  "functions": {
    "server.py": {
      "includeFiles": "dist/**/*",
      "excludeFiles": "{node_modules/**,src/**,.data/**}"
    }
  }
}
